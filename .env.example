# Copy to .env and fill in. .env is git-ignored; never commit real values.

# PostgreSQL (docker-compose.yml builds DATABASE_URL from these).
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobradar

# Shown in the scraper's User-Agent so board operators can see who is calling,
# e.g. the URL of your fork of this repository.
CONTACT_URL=

# Optional
HTTP_PORT=8080
SCRAPE_WORKERS=8
# Only needed when the UI is served from another origin. Comma-separated.
CORS_ORIGINS=
